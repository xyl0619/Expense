# Copy this file to .env and replace every placeholder before running Docker Compose.
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
JWT_SECRET=replace-with-the-output-of-openssl-rand-base64-64
ADMIN_USERNAME=admin
ADMIN_EMAIL=replace-with-your-admin-email
ADMIN_PASSWORD=replace-with-a-unique-admin-password
